# Ignore for VSCode extension packaging

# Source files (we bundle everything)
src/**
!src/**/*.d.ts

# Webview source and dev dependencies
webview-ui/src/**
webview-ui/node_modules/**
webview-ui/tsconfig*.json
webview-ui/vite.config.ts
webview-ui/package.json
webview-ui/package-lock.json

# Keep webview dist
!webview-ui/dist/**

# Development files
.vscode/**
.claude/**
.pi/**
.desloppify/**
.git/**
.gitignore
node_modules/**
.venv/**
*.vsix
tools/**

# Config files
.eslintrc.json
tsconfig.json

# Documentation (excluded from package)
docs/**
Orchestration Setup Resources/**
ARCHITECTURE.md
ARCHITECTURE_DECISIONS.md
TASK.md
SPECIFICATIONS.md
CLAUDE.md

# Only include these in final package
!out/**
!webview-ui/dist/**
!webview-ui/index.html
!package.json
!LICENSE.txt
!README.md
!CHANGELOG.md
!LICENSE
!images/**
!media/**
